wake_word:
  language: "en"
  # Per-character wake phrases (override defaults here, or leave empty to use built-in defaults)
  # phrases:
  #   rainbow_dash: ["hey dash", "hey dashie", "rainbow dash", "dash"]
  #   twilight_sparkle: ["hey twilight", "twilight sparkle", "twilight", "hey twi"]
  #   pinkie_pie: ["hey pinkie", "pinkie pie", "pinkie", "hey pinkie pie"]
  #   rarity: ["hey rarity", "rarity"]
  #   applejack: ["hey applejack", "applejack", "hey aj"]
  #   fluttershy: ["hey fluttershy", "fluttershy", "hey flutter"]

audio:
  input_device_index: -1       # run: python scripts/list_audio_devices.py
  output_device_index: -1
  vad_aggressiveness: 2        # 0-3 (3 = most aggressive silence detection)
  silence_duration_ms: 800

whisper:
  model: "base"                # tiny | base | small | medium
  language: "en"

llm:
  provider: "openai"           # anthropic | openai | openrouter | deepseek | groq | ollama | lmstudio | llamacpp | koboldcpp | textgen | vllm | localai | any OpenAI-compatible
  model: "gpt-4o"
  api_key: "YOUR_API_KEY"      # or set BONZI_LLM_API_KEY env var
  temperature: 0.85
  max_tokens: 1500
  max_history_turns: 10
  base_url: null               # auto-detected for known providers; set for custom endpoints (e.g. "http://localhost:1234/v1")
  preset: "twilight_sparkle"   # filename in presets/ folder (no .txt)
  relationship: "lover"        # lover | best_friend | roommate | caretaker | custom
  # relationship_custom: ""   # free-text (only used when relationship is "custom")
  # prefill: ""               # custom first-turn prefill. {name} = character name. blank = default

elevenlabs:
  api_key: "YOUR_ELEVENLABS_KEY"   # or set BONZI_ELEVENLABS_API_KEY env var
  voice_id: "YOUR_VOICE_ID"       # or set BONZI_ELEVENLABS_VOICE_ID env var
  model: "eleven_turbo_v2"
  output_format: "pcm_22050"

vision:
  enabled: true
  device_index: 0              # webcam index (0 = default camera)
  screen_capture: true         # enable screenshot capture
  screen_max_width: 1280       # downscale screenshots to this width
  screen_vision: api           # "api" = LLM describe_screen, "moondream" = local model (~2GB RAM)

conversation:
  timeout_s: 60                # seconds to stay in conversation mode after speaking
  listen_timeout_s: 4          # seconds to wait for user to START speaking in follow-up
  random_speech_chance: 0.001  # 0.1% chance per second of unprompted speech (only if agent disabled)

robot:
  enabled: false
  controller: "stub"           # stub | unitree_go2

logging:
  level: "INFO"
  log_to_file: true
  log_file: "logs/rainbow_dash.log"

desktop_control:
  enabled: true
  allowed_apps: ["notepad", "calculator", "explorer", "chrome", "firefox"]
  blocked_hotkeys: ["ctrl:alt:delete"]
  click_enabled: true
  type_enabled: true

agent:
  enabled: true
  self_initiate: true               # can the pony start talking on her own?
  max_directives: 3
  base_check_interval_s: 120.0      # seconds between LLM calls when idle
  min_check_interval_s: 30.0        # minimum interval at max urgency
  self_initiate_interval_s: 300.0   # seconds between self-initiation checks
  spontaneous_speech_min_s: 120.0   # min seconds between random check-ins
  spontaneous_speech_max_s: 300.0   # max seconds between random check-ins
  sustained_focus_threshold_s: 900.0
  distraction_keywords: ["youtube", "reddit", "tiktok", "twitch", "twitter", "instagram", "facebook"]

watch_mode:
  enabled: false                        # off by default — say "watch with me" to activate
  capture_interval: 2.5                 # seconds between screen captures
  scene_change_threshold: 0.85          # CLIP similarity threshold for scene change detection
  clip_model: "openai/clip-vit-base-patch32"
  ocr_engine: "winocr"                  # "winocr" (Windows built-in) or "pytesseract"
  subtitle_region_pct: 0.20             # bottom 20% of screen for subtitle OCR
  use_gpu: false                        # use CUDA for CLIP if available

desktop_pet:
  enabled: true
  scale: 2.0                  # sprite scale factor (originals are ~100px)
  speech_bubble: true          # show text bubbles alongside TTS
  pin_to: "bottom_right"       # hold one corner instead of wandering.
                               # bottom_right | bottom_left | top_right | top_left | center
                               # | left | right | top | bottom, or null to roam freely.
                               # The notification box is drawn directly above her, so a
                               # bottom corner leaves the most room for it.
  pin_margin: 12               # pixels from the screen work area (taskbar excluded)

tts:
  enabled: true
  provider: "elevenlabs"       # "elevenlabs" or "openai_compatible"
  # Settings below only apply when provider is "openai_compatible":
  # base_url: "http://localhost:8069/v1"
  # model: "ponyvoicetool"
  # voice: "default"
  # response_format: "pcm"
  # sample_rate: 24000

clop:
  # ── Your game login does NOT go in this file. ──────────────────────────────
  # Easiest way: right-click her -> 4CLOP -> Set Login. That writes it for you
  # and tells you whether she managed to log in.
  #
  # By hand: put these two lines in the .env file next to main.py --
  #     CLOP_USERNAME=your-4clop-username
  #     CLOP_PASSWORD=your-4clop-password
  # Those two are the only ones she needs. The bundled monitor's own .env.example
  # also asks for CLOP_NATION and CLOP_WEBHOOK_URL; both belong to features only
  # the standalone monitor runs, so leave them blank.
  # ──────────────────────────────────────────────────────────────────────────
  enabled: false               # turn on to run the 4CLOP monitor inside this process
  monitor_path: "clop_monitor"  # the bundled monitor. Point elsewhere for a dev checkout.
  base_url: "https://4clop.org/"
  # Left unset, these use the monitor checkout's own files:
  # settings_file: null        # defaults to <monitor_path>/settings.json
  # env_file: null             # names the file the login is READ from if it is not in the
  #                            # environment; defaults to <monitor_path>/.env
  # state_file: null           # defaults to <monitor_path>/.state/clop-monitor.json
  poll_interval_s: 60          # minimum 15 — it polls someone else's server
  # Which alerts reach the box is NOT set here — right-click her -> 4CLOP -> Notifications.
  # Kinds are toggles there; individual goods are muted from the "Mute Copper" button on the
  # notification itself. Both are stored in notify_filters.json next to main.py.
  speak_notifications: "never" # never | high | always.  The box is silent by default: at a
                               # 60s poll, reading every alert aloud means talking all day.
                               # She still speaks the welcome-back catch-up either way.
  strategy_thoughts: "rare"    # off | rare | on — how often she volunteers a read on your position
  read_alliance_messages: true  # let her read the alliance chat.
                               # WARNING: opening myalliance.php marks the whole alliance
                               # chat read for your account — in your own browser too.
                               # On, she can tell you what was said. Off, only how many.
  dossier_max_age_hours: 6.0   # how long a reading of another nation stays trusted before
                               # she spends a page fetch re-reading it
  roster_max_age_hours: 12.0   # how long the roster of who exists stays good for. It comes
                               # from the four regional rankings.php pages, which are public
                               # and cost nothing to read, and it is what lets you ask about
                               # a nation by name instead of by number.
  sheet_sync: true             # update the shared planning sheet each poll, exactly as the
                               # standalone monitor does — same function, same place in the
                               # poll, same cells. It is on only when CLOP_NATION names your
                               # tab (put it in clop_monitor/.env beside the login). Set this
                               # false if you would rather run clop_monitor.py yourself: two
                               # processes writing one tab is the only real hazard here.
  thread_check_hours: 1.0      # how often she reads the 4chan thread (0 to disable)
  thread_auto_find: true       # find the current /mlp/ general from the board catalog.
                               # Threads archive after a day or two, so leave this on and
                               # you never have to update a URL. Off, she uses only
                               # fourchan.thread_url in the monitor's settings.json.
  thread_board: "mlp"
  thread_url: ""               # pin her to one thread instead of finding it, e.g.
                               # "https://boards.4chan.org/mlp/thread/43454282".
                               # Leave empty unless she picks the wrong one -- a thread
                               # archives in a day or two and then this stops working.
                               # Settable from the right-click menu: 4CLOP -> The /mlp/ Thread.
