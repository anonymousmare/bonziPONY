# Copy this to .env and fill in your keys.
# You can set all of it from the right-click menu instead, which writes it here.
#
# For the BONZI_ keys below, config.yaml wins and these are only a fallback.
# For the CLOP_ keys at the bottom, it is the other way round: config.yaml has
# nowhere to put a game login, so this file (or the environment) is the place.

BONZI_LLM_API_KEY=sk-your-key-here
BONZI_LLM_PROVIDER=openai
BONZI_LLM_BASE_URL=

BONZI_ELEVENLABS_API_KEY=
BONZI_ELEVENLABS_VOICE_ID=

# ── 4CLOP ───────────────────────────────────────────────────────────────────
# Your game login, so she can watch the game for you. Set it from the
# right-click menu (4CLOP -> Set Login) and it gets written here for you.
# Also set clop.enabled: true in config.yaml, then restart her.
#
# These two are the ONLY ones she needs. The bundled monitor's own
# clop_monitor/.env.example asks for CLOP_NATION and CLOP_WEBHOOK_URL too --
# those belong to the planning-sheet sync and the Discord webhook, which only
# run when you start clop_monitor.py by itself. Leave them out here.
CLOP_USERNAME=
CLOP_PASSWORD=
